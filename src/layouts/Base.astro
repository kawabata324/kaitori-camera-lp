---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "買取カメラ｜かざすだけで、買取価格がわかる",
  description = "リユース・買取店向けのAI査定アシスト。商品をかざすと中古相場・推奨買取価格・想定粗利を即算出。楽天/Yahoo!の実勢価格、査定履歴、古物台帳CSVまで。",
} = Astro.props;
const appUrl = "https://genka-camera.vercel.app";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
    <script is:inline define:vars={{ appUrl }}>
      // IntersectionObserver で fade-up を発火
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("fade-up");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
