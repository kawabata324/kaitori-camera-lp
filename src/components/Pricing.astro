---
// モニター期は「100件まで無料」を訴求。応募は Google フォームへ。
import { APPLY_FORM_URL as contactHref } from "../consts";
const plans = [
  {
    name: "無料モニター",
    price: "100件",
    unit: "まで無料",
    desc: "先着のモニター店舗を募集中。まず現場で試せます。",
    features: [
      "AIカメラ査定・バーコード読取",
      "他店相場（楽天／Yahoo!）",
      "査定履歴・ダッシュボード",
      "導入サポート付き",
    ],
    cta: "モニターに応募",
    href: contactHref,
    highlight: true,
    badge: "募集中",
  },
  {
    name: "有料プラン",
    price: "¥9,800",
    unit: "／ 月〜（税別）",
    desc: "モニター後の継続利用に。査定件数に応じてご案内します。",
    features: [
      "月額 ¥9,800〜（件数に応じた従量）",
      "複数店舗・シート管理",
      "古物台帳エクスポート",
      "優先サポート",
    ],
    cta: "料金を問い合わせる",
    href: contactHref,
    highlight: false,
    badge: null,
  },
];
---

<section id="pricing" class="border-t border-slate-100 bg-slate-50/60">
  <div class="mx-auto max-w-6xl px-5 py-20">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2 class="text-3xl font-bold tracking-tight md:text-4xl">まずは無料モニターから</h2>
      <p class="mt-4 text-slate-600" style="text-wrap: balance;">
        <span class="inline-block">買取カメラは<span class="whitespace-nowrap">招待制のサービス</span>です。</span>
        <span class="inline-block">現在、<strong class="text-slate-800 whitespace-nowrap">100件まで無料</strong>で試せる<span class="whitespace-nowrap">モニター店舗</span>を募集しています。</span>
      </p>
    </div>
    <div class="mx-auto mt-14 grid max-w-3xl gap-6 md:grid-cols-2">
      {plans.map((p) => (
        <div
          class={`relative rounded-2xl border bg-white p-7 ${p.highlight ? "border-brand shadow-lg ring-1 ring-brand/20" : "border-slate-100 shadow-sm"}`}
          data-reveal
        >
          {p.badge && <span class="mb-3 inline-block rounded-full bg-brand/10 px-3 py-1 text-xs font-semibold text-brand">{p.badge}</span>}
          <h3 class="text-lg font-semibold">{p.name}</h3>
          <p class="mt-1 text-sm text-slate-500">{p.desc}</p>
          <div class="mt-5 flex items-end gap-1">
            <span class="text-3xl font-bold">{p.price}</span>
            <span class="pb-1 text-sm text-slate-500">{p.unit}</span>
          </div>
          <ul class="mt-6 space-y-3">
            {p.features.map((f) => (
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#1a73e8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0"><path d="M20 6 9 17l-5-5"/></svg>
                {f}
              </li>
            ))}
          </ul>
          <a href={p.href} target="_blank" rel="noopener" class={`mt-7 block rounded-xl px-4 py-3 text-center text-sm font-semibold transition-colors ${p.highlight ? "bg-brand text-white hover:bg-brand-600" : "border border-slate-200 text-slate-700 hover:bg-slate-50"}`}>
            {p.cta}
          </a>
        </div>
      ))}
    </div>
    <p class="mt-6 text-center text-xs text-slate-400">※ 月額 ¥9,800（税別）〜。査定件数に応じて個別にご案内します。表示価格は参考です。</p>
  </div>
</section>
