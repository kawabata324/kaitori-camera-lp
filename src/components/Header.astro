---
const appUrl = "https://genka-camera.vercel.app";
const nav = [
  { label: "機能", href: "#features" },
  { label: "使い方", href: "#how" },
  { label: "料金", href: "#pricing" },
  { label: "よくある質問", href: "#faq" },
];
---

<header class="sticky top-0 z-50 border-b border-slate-100 bg-white/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="#top" class="flex items-center gap-2">
      <span class="grid size-8 place-items-center rounded-lg bg-brand text-white">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2" />
          <circle cx="12" cy="12" r="3.2" />
        </svg>
      </span>
      <span class="text-[15px] font-semibold tracking-tight">買取カメラ</span>
    </a>
    <nav class="hidden items-center gap-7 md:flex">
      {nav.map((n) => <a href={n.href} class="text-sm text-slate-600 transition-colors hover:text-slate-900">{n.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href={appUrl + "/login"} class="hidden text-sm font-medium text-slate-700 hover:text-slate-900 sm:block">ログイン</a>
      <a href="#cta" class="rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-600">モニターに応募</a>
    </div>
  </div>
</header>
