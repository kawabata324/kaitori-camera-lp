---
const points = [
  { title: "査定を集計", body: "件数・平均買取率・粗利を自動でダッシュボード化。店舗の傾向がひと目で分かります。" },
  { title: "履歴から再確認", body: "過去の査定を一覧・詳細で振り返り。相場の根拠や成約額をあとから確認できます。" },
  { title: "古物台帳をCSV出力", body: "成約時の記帳をそのまま台帳に。CSVでダウンロードでき、法定の管理もラクに。" },
];
---

<section id="dashboard" class="mx-auto max-w-6xl px-5 py-20">
  <div class="mx-auto max-w-2xl text-center" data-reveal>
    <h2 class="text-3xl font-bold tracking-tight md:text-4xl">
      <span class="inline-block">現場の査定を、</span>
      <span class="inline-block">そのまま<span class="text-brand">経営データ</span>に。</span>
    </h2>
    <p class="mt-4 text-slate-600" style="text-wrap: balance;">
      <span class="inline-block">スマホで査定した記録は、PCの管理画面に自動で集約。</span>
      <span class="inline-block">集計・履歴・古物台帳まで、店舗運営に必要な情報がそろいます。</span>
    </p>
  </div>

  <!-- ブラウザ風フレームでPCダッシュボードのデモ -->
  <div class="mx-auto mt-12 max-w-4xl" data-reveal>
    <div class="device-frame">
      <div class="flex items-center gap-1.5 border-b border-slate-100 bg-slate-50 px-4 py-2.5">
        <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
        <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
        <span class="size-2.5 rounded-full bg-[#28c840]"></span>
        <span class="mx-auto flex items-center gap-1.5 rounded-md bg-white px-3 py-1 text-xs text-slate-400">
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="9" width="16" height="12" rx="2"/><path d="M8 9V6a4 4 0 0 1 8 0v3"/></svg>
          app.kaitori-camera
        </span>
      </div>
      <video
        class="block w-full"
        autoplay
        muted
        loop
        playsinline
      >
        <source src="/media/dashboard.mp4" type="video/mp4" />
      </video>
    </div>
  </div>

  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {points.map((p) => (
      <div class="rounded-2xl border border-slate-100 bg-white p-6" data-reveal>
        <h3 class="text-base font-semibold">{p.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600" style="text-wrap: pretty;">{p.body}</p>
      </div>
    ))}
  </div>
</section>
